<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/newtermux_toolbar_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/nt_toolbar_bg">

    <!-- Top bar: app name + feature buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="2dp">

        <TextView
            android:id="@+id/tv_app_title"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="3dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="☰ NT"
            android:contentDescription="@string/newtermux_toolbar_open_drawer"
            android:singleLine="true"
            android:textColor="@color/nt_toolbar_text"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <!-- Primary quick action: copy full terminal transcript -->
        <TextView
            android:id="@+id/btn_copy_visible"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_package_button"
            android:backgroundTint="@color/nt_quick_copy"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:text="@string/newtermux_toolbar_copy"
            android:textColor="@color/nt_on_surface"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Primary quick action: clear current terminal screen -->
        <TextView
            android:id="@+id/btn_clear_terminal"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_package_button"
            android:backgroundTint="@color/nt_quick_clear"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="CLS"
            android:textColor="@color/nt_on_surface"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Primary quick action: paste clipboard and immediately send Enter -->
        <TextView
            android:id="@+id/btn_paste_enter"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_package_button"
            android:backgroundTint="@color/nt_quick_paste_enter"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:text="@string/newtermux_toolbar_paste_enter"
            android:textColor="@color/nt_on_surface"
            android:textSize="11sp"
            android:textStyle="bold" />



        <!-- Autocorrect Toggle Button -->
        <TextView
            android:id="@+id/btn_autocorrect_toggle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_package_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="AC"
            android:textColor="@color/nt_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Packages Button -->
        <TextView
            android:id="@+id/btn_packages_menu"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_package_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/newtermux_toolbar_packages"
            android:textColor="@color/nt_on_surface"
            android:textSize="11sp"
            android:textStyle="bold" />



        <!-- New session button -->
        <ImageButton
            android:id="@+id/btn_new_session"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/newtermux_toolbar_new_session"
            android:src="@drawable/ic_add_session"
            android:tint="@color/nt_toolbar_icon"
            android:padding="10dp" />


        <!-- Speech-to-Text button -->
        <ImageButton
            android:id="@+id/btn_stt"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/newtermux_toolbar_speech"
            android:src="@drawable/ic_mic"
            android:tint="@color/nt_stt_idle"
            android:padding="10dp" />

        <!-- Compact overflow for secondary terminal actions -->
        <TextView
            android:id="@+id/btn_more_actions"
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:contentDescription="@string/newtermux_toolbar_more"
            android:text="⋮"
            android:textColor="@color/nt_toolbar_icon"
            android:textSize="28sp" />

        <!-- Settings button -->
        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/newtermux_toolbar_settings"
            android:src="@drawable/ic_settings"
            android:tint="@color/nt_toolbar_icon"
            android:padding="10dp" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/nt_divider" />

    <!-- Compact live summary for recognized long-running terminal tasks. -->
    <LinearLayout
        android:id="@+id/task_status_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="58dp"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="5dp"
        android:background="@color/nt_tab_bg"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/task_status_dot"
                android:layout_width="18dp"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:text="●"
                android:textSize="13sp"
                android:textColor="@android:color/holo_green_light" />

            <TextView
                android:id="@+id/task_status_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/nt_toolbar_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/task_status_elapsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="monospace"
                android:textColor="@color/nt_toolbar_text"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/task_status_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/nt_on_surface"
            android:textSize="10sp" />

        <ProgressBar
            android:id="@+id/task_status_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginStart="18dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="0" />
    </LinearLayout>

        <!-- Session pip row (live mini terminal previews) -->
    <HorizontalScrollView
        android:id="@+id/session_tabs_scroll"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:scrollbars="none"
        android:background="@color/nt_tab_bg">

        <LinearLayout
            android:id="@+id/session_pip_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:gravity="center_vertical" />

    </HorizontalScrollView>

    <!-- Bottom divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/nt_divider" />

</LinearLayout>
