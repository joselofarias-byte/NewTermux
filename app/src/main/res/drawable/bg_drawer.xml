<?xml version="1.0" encoding="utf-8"?>
<!-- Left navigation drawer panel: surface fill with the Bannerlator-style outline,
     rounded on the right (visible) edge. -->
<shape android:shape="rectangle"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/nt_surface" />
    <stroke android:width="1dp" android:color="@color/nt_menu_outline" />
    <corners
        android:topRightRadius="14dp"
        android:bottomRightRadius="14dp" />
</shape>
